# GEMINI_API_KEY: Optional/Required for full Gemini AI features.
# If omitted or empty, LifeOS operates seamlessly in offline mode with smart local fallbacks.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Optional secret key used for session token generation.
# If omitted, LifeOS will automatically generate an in-memory random secret on boot.
SESSION_SECRET=""

# APP_URL: The URL where this applet is hosted (auto-injected in production environments).
APP_URL="http://localhost:3000"
